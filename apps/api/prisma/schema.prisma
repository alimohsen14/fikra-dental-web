generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums
enum Role {
  PLATFORM_ADMIN
  OWNER
  DOCTOR
  SECRETARY
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MessageKind {
  BOOKING
  CONFIRMATION
}

enum MessageStatus {
  SCHEDULED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum MessageResponse {
  YES
  NO
}

enum TreatmentStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum SessionStatus {
  PLANNED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  ACTIVE
  VOIDED
}

// ---------------------------------------------------------------- platform
model Clinic {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  logoUrl            String?
  themeColor         String?
  currency           String       @default("ILS")
  timezone           String       @default("Asia/Hebron")
  status             ClinicStatus @default(ACTIVE)
  subscriptionEndsAt DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  whatsapp       ClinicWhatsapp?
  bookingLinks   BookingLink[]
  expenseCategories ExpenseCategory[]
  suppliers      Supplier[]
  expenses       Expense[]
  expensePayments ExpensePayment[]
  salaryEntries   SalaryEntry[]
  salaryPayments  SalaryPayment[]
  xrays          XRay[]
  users          User[]
  doctors        Doctor[]
  workingPeriods DoctorWorkingPeriod[]
  patients       Patient[]
  appointments   Appointment[]
  messages       MessageLog[]
  treatmentTypes TreatmentType[]
  treatments     Treatment[]
  treatmentTeeth TreatmentTooth[]
  sessions       Session[]
  payments       Payment[]
  auditLogs      AuditLog[]

  subscriptionPeriods  SubscriptionPeriod[]
  subscriptionPayments SubscriptionPayment[]
}

// WhatsApp credentials per clinic. The token is stored encrypted and never reaches the frontend.
model ClinicWhatsapp {
  clinicId          String   @id @db.Uuid
  phoneNumberId     String
  businessAccountId String?
  accessTokenEnc    String
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- people
model User {
  id                String   @id @default(uuid()) @db.Uuid
  clinicId          String?  @db.Uuid // null only for PLATFORM_ADMIN
  username          String   @unique // store lowercase; unique across the whole system
  passwordHash      String
  fullName          String
  phone             String?
  role              Role
  canManagePayments Boolean  @default(false)
  isActive          Boolean  @default(true)
  monthlySalary     Int? // agorot; set by the owner for doctors and secretaries
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  mustChangePassword         Boolean   @default(false)
  passwordChangedAt          DateTime? @db.Timestamptz(3)
  temporaryPasswordExpiresAt DateTime? @db.Timestamptz(3)
  failedLoginCount           Int       @default(0)
  lockedUntil                DateTime? @db.Timestamptz(3)

  // The clinic owner must accept the terms of use (see src/legal). Version = the text they saw.
  termsAcceptedVersion String?
  termsAcceptedAt      DateTime? @db.Timestamptz(3)

  // Two-factor login (PLATFORM_ADMIN). The secret is stored encrypted, never in plain text.
  totpSecret    String?
  totpEnabledAt DateTime? @db.Timestamptz(3)
  totpLastStep  Int? // last accepted 30-second step: a code can never be used twice

  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  doctor        Doctor?
  refreshTokens RefreshToken[]
  recoveryCodes RecoveryCode[]
  salaryEntries SalaryEntry[]
  xrays         XRay[]

  @@index([clinicId])
}

model Doctor {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @db.Uuid
  userId             String?  @unique @db.Uuid // optional login account (the owner is also a doctor)
  fullName           String
  specialty          String?
  phone              String?
  appointmentMinutes Int      @default(30)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  clinic         Clinic                @relation(fields: [clinicId], references: [id])
  user           User?                 @relation(fields: [userId], references: [id])
  workingPeriods DoctorWorkingPeriod[]
  appointments   Appointment[]
  treatments     Treatment[]

  @@index([clinicId])
}

// Several periods per day are allowed (morning and evening).
model DoctorWorkingPeriod {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  doctorId    String @db.Uuid
  weekday     Int // 0 = Sunday ... 6 = Saturday
  startMinute Int // minutes from midnight, e.g. 540 = 09:00
  endMinute   Int

  clinic Clinic @relation(fields: [clinicId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([clinicId, doctorId])
}

model Patient {
  id            String    @id @default(uuid()) @db.Uuid
  clinicId      String    @db.Uuid
  fullName      String
  phone         String // international format, e.g. +970599123456
  nationalId    String?
  birthDate     DateTime? @db.Date
  gender        Gender?
  region        String?
  address       String?
  notes         String?
  medicalAlerts String?
  archivedAt    DateTime? @db.Timestamptz(3)
  selfRegistered Boolean  @default(false) // registered by the patient through the booking page; stays flagged until a treatment is opened for them
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  treatments   Treatment[]
  payments     Payment[]
  xrays        XRay[]

  @@unique([clinicId, nationalId])
  @@index([clinicId, phone])
  @@index([clinicId, fullName])
}

// The link the patient gets on WhatsApp. It carries the phone number WhatsApp itself reported as the sender,
// so the booking page never asks "who are you": only the records of that phone are visible. Only a hash of the token is stored.
model BookingLink {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  phone     String // +970..., from the incoming WhatsApp message
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, phone, createdAt])
}

// ---------------------------------------------------------------- appointments
model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  clinicId     String            @db.Uuid
  patientId    String            @db.Uuid
  doctorId     String            @db.Uuid
  startsAt     DateTime          @db.Timestamptz(3)
  endsAt       DateTime          @db.Timestamptz(3)
  status       AppointmentStatus @default(PENDING)
  notes        String?
  cancelReason String?
  confirmedAt  DateTime?         @db.Timestamptz(3)
  completedAt  DateTime?         @db.Timestamptz(3)
  cancelledAt  DateTime?         @db.Timestamptz(3)
  bookedByPatient Boolean        @default(false) // booked by the patient himself through the WhatsApp link
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  clinic     Clinic       @relation(fields: [clinicId], references: [id])
  patient    Patient      @relation(fields: [patientId], references: [id])
  doctor     Doctor       @relation(fields: [doctorId], references: [id])
  messages   MessageLog[]
  session    Session?
  treatments Treatment[]

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
}

// One row per message per appointment. Reschedule updates the row, so nothing is sent twice.
model MessageLog {
  id            String           @id @default(uuid()) @db.Uuid
  clinicId      String           @db.Uuid
  appointmentId String           @db.Uuid
  kind          MessageKind
  status        MessageStatus    @default(SCHEDULED)
  toPhone       String
  scheduledFor  DateTime         @db.Timestamptz(3)
  sentAt        DateTime?        @db.Timestamptz(3)
  waMessageId   String?
  body          String? // the text that was sent, so the clinic can see exactly what the patient got
  errorMessage  String?
  response      MessageResponse?
  respondedAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, kind])
  @@index([clinicId, status, scheduledFor])
}

// ---------------------------------------------------------------- treatments
model TreatmentType {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  parentId  String?  @db.Uuid // a sub-type points at its type (two levels only: crown -> zirconia)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  clinic     Clinic          @relation(fields: [clinicId], references: [id])
  parent     TreatmentType?  @relation("TypeChildren", fields: [parentId], references: [id])
  children   TreatmentType[] @relation("TypeChildren")
  teeth      TreatmentTooth[]

  @@unique([clinicId, parentId, name])
  @@index([clinicId, parentId])
}

// One treatment = one or more teeth (each with its own type) + ONE total cost + ONE session count.
model Treatment {
  id              String          @id @default(uuid()) @db.Uuid
  clinicId        String          @db.Uuid
  patientId       String          @db.Uuid
  doctorId        String          @db.Uuid
  appointmentId   String?         @db.Uuid // set when opened from a booked appointment
  description     String?
  totalCost       Int // smallest currency unit (agorot). Never float.
  plannedSessions Int
  status          TreatmentStatus @default(OPEN)
  startedAt       DateTime        @db.Timestamptz(3)
  closedAt        DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  clinic        Clinic           @relation(fields: [clinicId], references: [id])
  patient       Patient          @relation(fields: [patientId], references: [id])
  doctor        Doctor           @relation(fields: [doctorId], references: [id])
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  teeth         TreatmentTooth[]
  sessions      Session[]
  payments      Payment[]
  xrays         XRay[]

  @@index([clinicId, patientId])
  @@index([clinicId, status])
}

model TreatmentTooth {
  clinicId        String @db.Uuid
  treatmentId     String @db.Uuid
  toothCode       Int // FDI numbering: permanent 11-48, primary 51-85
  treatmentTypeId String @db.Uuid // every tooth has its own type; cost and sessions are shared by the whole treatment

  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  treatment     Treatment     @relation(fields: [treatmentId], references: [id])
  treatmentType TreatmentType @relation(fields: [treatmentTypeId], references: [id])

  @@id([treatmentId, toothCode])
  @@index([clinicId, toothCode])
  @@index([clinicId, treatmentTypeId])
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  treatmentId   String        @db.Uuid
  number        Int
  status        SessionStatus @default(PLANNED)
  appointmentId String?       @unique @db.Uuid
  completedAt   DateTime?     @db.Timestamptz(3)
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  treatment   Treatment    @relation(fields: [treatmentId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([treatmentId, number])
}

// ---------------------------------------------------------------- money
// Payments are never deleted. A wrong payment is voided with a reason and stays visible.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  patientId       String        @db.Uuid
  treatmentId     String        @db.Uuid
  amount          Int // smallest currency unit, must be > 0
  method          PaymentMethod
  paidAt          DateTime      @db.Timestamptz(3)
  note            String?
  status          PaymentStatus @default(ACTIVE)
  voidedAt        DateTime?     @db.Timestamptz(3)
  voidReason      String?
  voidedByUserId  String?       @db.Uuid
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@index([clinicId, patientId])
  @@index([treatmentId])
  @@index([clinicId, paidAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@index([clinicId, createdAt])
  @@index([entityType, entityId])
}

// Login sessions. Only a hash of the token is stored. Tokens rotate on every refresh;
// `familyId` links a chain so a reused (stolen) token revokes the whole chain.
// Auth tables are read before the clinic is known, so they are exempt from clinicId filtering.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// One-time backup codes for two-factor login. Only a hash is stored; each works once.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// What the clinic owes the platform. One period per paid subscription term (created when you
// create or renew a clinic with a price). `Clinic.subscriptionEndsAt` still decides access;
// a period only tracks money. Not granted to fikra_app: clinic users can never see it.
model SubscriptionPeriod {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  months          Int? // null when an exact end date was chosen
  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  price           Int // smallest currency unit (agorot), >= 0
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  clinic   Clinic                @relation(fields: [clinicId], references: [id])
  payments SubscriptionPayment[]

  @@index([clinicId, endsAt])
}

// Payments are never deleted: a wrong one is voided with a reason.
model SubscriptionPayment {
  id              String    @id @default(uuid()) @db.Uuid
  periodId        String    @db.Uuid
  clinicId        String    @db.Uuid
  amount          Int // smallest currency unit, must be > 0
  paidAt          DateTime  @db.Timestamptz(3)
  note            String?
  voidedAt        DateTime? @db.Timestamptz(3)
  voidReason      String?
  voidedByUserId  String?   @db.Uuid
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  period SubscriptionPeriod @relation(fields: [periodId], references: [id])
  clinic Clinic             @relation(fields: [clinicId], references: [id])

  @@index([periodId])
  @@index([clinicId, paidAt])
}

// ---------------------------------------------------------------- expenses (owner only)
model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  expenses Expense[]

  @@unique([clinicId, name])
}

// Whoever the clinic buys from or owes money to (a shop, a lab, an employee).
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  expenses Expense[]

  @@unique([clinicId, name])
}

// One bill. What is still owed on it = amount - active payments. Never deleted: a wrong one is voided with a reason.
model Expense {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  categoryId      String        @db.Uuid
  supplierId      String?       @db.Uuid
  description     String?
  amount          Int // smallest currency unit, must be > 0
  incurredAt      DateTime      @db.Timestamptz(3) // the day of the purchase / the bill
  status          PaymentStatus @default(ACTIVE)
  voidedAt        DateTime?     @db.Timestamptz(3)
  voidReason      String?
  voidedByUserId  String?       @db.Uuid
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  clinic   Clinic            @relation(fields: [clinicId], references: [id])
  category ExpenseCategory   @relation(fields: [categoryId], references: [id])
  supplier Supplier?         @relation(fields: [supplierId], references: [id])
  payments ExpensePayment[]

  @@index([clinicId, incurredAt])
  @@index([clinicId, supplierId])
}

// Money that actually left the clinic. The profit of a period counts these, by the day they were paid.
model ExpensePayment {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  expenseId       String        @db.Uuid
  amount          Int // must be > 0
  method          PaymentMethod
  paidAt          DateTime      @db.Timestamptz(3)
  note            String?
  status          PaymentStatus @default(ACTIVE)
  voidedAt        DateTime?     @db.Timestamptz(3)
  voidReason      String?
  voidedByUserId  String?       @db.Uuid
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  expense Expense @relation(fields: [expenseId], references: [id])

  @@index([clinicId, paidAt])
  @@index([expenseId])
}

enum SalaryPaymentKind {
  SALARY
  ADVANCE // taken before payday; counts against the same month's salary
}

/// One employee's salary for one month ("2026-11"). baseAmount is copied from the employee's
/// monthly salary when the month is opened, so raising the salary later never rewrites old months.
model SalaryEntry {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  userId     String   @db.Uuid
  month      String
  baseAmount Int
  adjustment Int      @default(0) // bonus (+) or deduction (-) for this month only
  adjustNote String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  clinic   Clinic          @relation(fields: [clinicId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  payments SalaryPayment[]

  @@unique([clinicId, userId, month])
  @@index([clinicId, month])
}

model SalaryPayment {
  id              String            @id @default(uuid()) @db.Uuid
  clinicId        String            @db.Uuid
  entryId         String            @db.Uuid
  kind            SalaryPaymentKind
  amount          Int // must be > 0
  method          PaymentMethod
  paidAt          DateTime          @db.Timestamptz(3)
  note            String?
  status          PaymentStatus     @default(ACTIVE)
  voidedAt        DateTime?         @db.Timestamptz(3)
  voidReason      String?
  voidedByUserId  String?           @db.Uuid
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  clinic Clinic      @relation(fields: [clinicId], references: [id])
  entry  SalaryEntry @relation(fields: [entryId], references: [id])

  @@index([clinicId, paidAt])
  @@index([entryId])
}

// An X-ray image added on a treatment. It also shows in the patient's record. The file itself lives in the upload folder
// (never served without a login), only its stored name is kept here.
model XRay {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  patientId        String   @db.Uuid
  treatmentId      String   @db.Uuid
  file             String // stored file name, unguessable
  mime             String
  size             Int
  note             String?
  uploadedByUserId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  clinic     Clinic    @relation(fields: [clinicId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
  treatment  Treatment @relation(fields: [treatmentId], references: [id])
  uploadedBy User      @relation(fields: [uploadedByUserId], references: [id])

  @@index([clinicId, patientId])
  @@index([treatmentId])
}
